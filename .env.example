# Copy to .env for local development. Production values live in the Vercel project.

# Sanity (content). Only needed if the dataset is private.
# SANITY_READ_TOKEN=

# Brand enquiries and the morning applications email.
RESEND_API_KEY=

# Review mode: placeholders and dev notes show. Always on in `astro dev`.
# PUBLIC_SHOW_PLACEHOLDERS=true

# Creator CRM (Supabase project "Dogfluencers", Ireland region, eu-west-1).
# Project Settings > API.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Full access. Server only: never prefix with PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Project Settings > Database > Connection string (URI). Only used by
# scripts/db-migrate.ts and scripts/add-admin.ts, never by the site.
SUPABASE_DB_URL=

# While testing: who the site may email (comma-separated domains or
# addresses). Remove at launch so every creator can be emailed.
CRM_EMAIL_ALLOWLIST=gymfluencers.agency,fluencersgroup.com
# The morning applications email sends only when this is true.
# CRM_DIGEST_ENABLED=true

# Vercel sends this to the morning email cron. Any long random string.
CRON_SECRET=
