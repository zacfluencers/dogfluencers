---
import type { AgencyConfig } from '../../types/agency';
import type { Seo } from '../../types/content';
import { resolveSeo } from '../../lib/seo';

interface Props {
  agency: AgencyConfig;
  seo?: Seo;
  ogType?: 'website' | 'article';
}
const { agency, seo, ogType = 'website' } = Astro.props;
const resolved = resolveSeo(agency, seo, Astro.url);
// Size and description of the share image, so previews render without a fetch.
const image = seo?.socialImage ?? agency.seo.socialImage;
---

<title>{resolved.title}</title>
<meta name="description" content={resolved.description} />
<link rel="canonical" href={resolved.canonical} />
{resolved.noIndex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={agency.name} />
<meta property="og:title" content={resolved.title} />
<meta property="og:description" content={resolved.description} />
<meta property="og:url" content={resolved.canonical} />
<meta property="og:locale" content={agency.site.locale.replace('-', '_')} />
{resolved.socialImage && <meta property="og:image" content={resolved.socialImage} />}
{resolved.socialImage && image?.width && <meta property="og:image:width" content={String(image.width)} />}
{resolved.socialImage && image?.height && <meta property="og:image:height" content={String(image.height)} />}
{resolved.socialImage && image?.alt && <meta property="og:image:alt" content={image.alt} />}

<meta name="twitter:card" content={resolved.socialImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={resolved.title} />
<meta name="twitter:description" content={resolved.description} />
{resolved.socialImage && <meta name="twitter:image" content={resolved.socialImage} />}
{resolved.socialImage && image?.alt && <meta name="twitter:image:alt" content={image.alt} />}
