---
/**
 * Horizontal scrolling gallery on mobile, grid at wider widths. Creator content
 * is the subject here, not decoration.
 */
import type { ImageRef } from '../../types/content';
import Container from '../global/Container.astro';
import Section from '../global/Section.astro';
import Media from '../global/Media.astro';

interface Props {
  eyebrow?: string;
  heading?: string;
  images: ImageRef[];
}
const { eyebrow, heading, images } = Astro.props;
---

{
  images.length > 0 && (
    <Section spacing="tight">
      <Container>
        {(eyebrow || heading) && (
          <div class="heading-stack mb-10">
            {eyebrow && <p class="type-eyebrow muted">{eyebrow}</p>}
            {heading && <h2 class="reveal-mask type-display-m">{heading}</h2>}
          </div>
        )}
      </Container>

      <ul
        class="flex snap-x snap-mandatory gap-4 overflow-x-auto px-[var(--gutter)] pb-4 sm:grid sm:grid-cols-3 sm:overflow-visible sm:pb-0 lg:grid-cols-4"
      >
        {images.map((image) => (
          <li class="w-[70vw] shrink-0 snap-start sm:w-auto">
            <Media media={image} ratio="4 / 5" fallbackLabel="Creator content" />
          </li>
        ))}
      </ul>
    </Section>
  )
}
