---
/**
 * A portrait clip beside a heading and a hairline list: the image-led
 * version of the sticky heading and list used elsewhere. The clip holds its
 * place while the list scrolls past it at desktop width, and plays while on
 * screen.
 */
import type { ComponentProps } from 'astro/types';
import type { VideoRef } from '../../types/content';
import Container from '../global/Container.astro';
import Section from '../global/Section.astro';
import ClipTile from '../global/ClipTile.astro';
import ClipsToggle from '../global/ClipsToggle.astro';

interface Item {
  title: string;
  body?: string;
}

interface Props {
  tone?: ComponentProps<typeof Section>['tone'];
  heading: string;
  /** A paragraph between the heading and the list. */
  lead?: string;
  items: Item[];
  video: VideoRef;
  /** Which side the clip sits on at desktop width. */
  side?: 'left' | 'right';
}
const { tone, heading, lead, items, video, side = 'left' } = Astro.props;
---

<Section tone={tone}>
  <Container>
    <div class:list={['media-feature', side === 'right' && 'media-feature-right']} data-clip-group>
      <div class="media-feature-clip">
        <ClipTile video={video} ratio="4 / 5" />
        <div class="mt-5 flex justify-end">
          <ClipsToggle />
        </div>
      </div>

      <div class="flex flex-col gap-12">
        <div class="heading-stack">
          <h2 class="reveal-mask type-display-l">{heading}</h2>
          {lead && <p class="reveal-rise type-lead measure" style="--reveal-delay: 120ms">{lead}</p>}
        </div>

        <ul class="grid gap-x-10 gap-y-10 sm:grid-cols-2" data-reveal-group>
          {
            items.map((item) => (
              <li class="flex flex-col gap-3 border-t border-[var(--hairline-strong)] pt-6">
                <h3 class="type-heading">{item.title}</h3>
                {item.body && <p class="type-body muted">{item.body}</p>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </Container>
</Section>

<style>
  .media-feature {
    display: grid;
    gap: var(--space-7);
  }
  /* On a phone the clip would fill a whole screen at full width, and it
     follows the copy, so the band opens with what it is about. */
  .media-feature-clip {
    max-width: 22rem;
    order: 2;
  }
  /* Two equal halves, the site's shared split: the second column starts on
     the 4-up grid's third column, like SectionHeader. The clip is capped
     within its half rather than filling it. */
  @media (min-width: 1024px) {
    .media-feature {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      align-items: start;
    }
    .media-feature-clip {
      order: 0;
      position: sticky;
      top: calc(var(--header-h) + var(--space-5));
      max-width: 26rem;
      width: 100%;
    }
    .media-feature-right > .media-feature-clip {
      order: 2;
    }
  }
</style>
