---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../agency/components/sections/CtaBand.astro';
import ArticleCard from '../../agency/components/ui/ArticleCard.astro';
import Photo from '../../agency/components/ui/Photo.astro';
import { agency } from '../../agency/config';
import { content } from '../../content';
import { articleSchema, breadcrumbSchema } from '../../system/lib/seo';

import Container from '../../system/components/global/Container.astro';
import Section from '../../system/components/global/Section.astro';
import RichText from '../../system/components/global/RichText.astro';

export const getStaticPaths = (async () => {
  const articles = await content.articles();
  return articles.map((article) => ({ params: { slug: article.slug }, props: { article } }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const articles = await content.articles();

const related = (
  article.relatedArticles?.length
    ? articles.filter((item) => article.relatedArticles!.includes(item.slug))
    : articles.filter((item) => item.slug !== article.slug)
).slice(0, 3);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Insights', href: '/insights/' },
  { label: article.title },
];

const formattedDate = article.publishDate
  ? new Date(article.publishDate).toLocaleDateString('en-GB', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    })
  : undefined;
// The excerpt leads the page unless the article already opens with it (as
// the posts migrated from WordPress do), so it never reads twice.
const squash = (t: string) => t.replace(/\s+/g, ' ').trim().toLowerCase();
const opening = article.body.find((b) => b.type === 'paragraph');
const leadRepeats = Boolean(opening && squash(opening.text).startsWith(squash(article.excerpt)));
---

<BaseLayout
  ogType="article"
  seo={article.seo ?? { title: article.title, description: article.excerpt }}
  schemas={[articleSchema(agency, article), breadcrumbSchema(agency, breadcrumbs)]}
>
  <article>
    <header class="band-paper dpost-head">
      <Container width="text">
        <nav aria-label="Breadcrumb" class="dpost-crumbs enter enter-1">
          <a href="/">Home</a><span aria-hidden="true">/</span><a href="/insights/">Insights</a>
        </nav>
        <div class="dpost-meta enter enter-1">
          {article.category && <span class="dpost-cat">{article.category}</span>}
          {formattedDate && <time datetime={article.publishDate}>{formattedDate}</time>}
          {article.author && <span>{article.author}</span>}
        </div>
        <h1 class="d-h1 enter enter-2">{article.title}</h1>
        {!leadRepeats && <p class="d-lead d-muted mt-7 enter enter-3">{article.excerpt}</p>}
      </Container>
    </header>

    {article.featuredImage && (
      <div class="wrap enter enter-3">
        <Photo src={article.featuredImage.src} alt={article.featuredImage.alt} ratio="16 / 9" eager />
      </div>
    )}

    <Section spacing="tight">
      <Container width="text">
        <RichText blocks={article.body} />
      </Container>
    </Section>
  </article>

  {related.length > 0 && (
    <section class="band band-cream">
      <div class="wrap">
        <p class="d-ui dpost-more">More insights</p>
        <ul class="dpost-grid" data-reveal-group>
          {related.map((item) => <li><ArticleCard article={item} /></li>)}
        </ul>
      </div>
    </section>
  )}

  <CtaBand
    heading="Start a *campaign.*"
    description="Tell us what you are launching and we will come back with an approach."
    primaryCta={agency.ctas.primary}
    secondaryCta={agency.ctas.secondary}
  />
</BaseLayout>

<style>
  .dpost-head { padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4rem); }
  .dpost-crumbs { display: flex; gap: 0.5rem; margin-bottom: clamp(2rem, 5vw, 3rem); font-size: 0.875rem; font-weight: 600; color: var(--night-muted); }
  .dpost-crumbs a { color: inherit; text-decoration: none; }
  .dpost-crumbs a:hover { color: var(--orange-text); }
  .dpost-meta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; margin-bottom: 1.5rem; font-size: 0.875rem; font-weight: 600; color: var(--night-muted); }
  .dpost-cat { padding: 0.35rem 0.75rem; border-radius: 999px; background: var(--cream); color: var(--night); }
  .dpost-more { margin-bottom: 2rem; color: var(--accent); }
  .dpost-grid { display: grid; gap: 3rem var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .dpost-grid :global(.dphoto) { background: var(--paper); }
  @media (min-width: 40rem) { .dpost-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .dpost-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
