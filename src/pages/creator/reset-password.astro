---
/**
 * Choose a password. Reached from an emailed link (a reset, or a creator from
 * the old site setting up their login), which signs them in first.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { passwordSchema } from '../../system/crm/validation';
import { isAdmin } from '../../system/crm/supabase';

import PageHead from '../../agency/components/sections/PageHead.astro';
import Section from '../../system/components/global/Section.astro';
import Container from '../../system/components/global/Container.astro';
import Button from '../../system/components/global/Button.astro';
import FormField from '../../system/components/crm/FormField.astro';

export const prerender = false;

// The middleware has already sent anyone signed out to the login page.
const session = Astro.locals.session;
const claim = Astro.url.searchParams.has('claim');
const errors: Record<string, string> = {};
let message: string | undefined;

if (Astro.request.method === 'POST' && session?.user) {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const parsed = passwordSchema.safeParse(password);
  if (!parsed.success) errors.password = parsed.error.issues[0].message;
  else if (password !== String(form.get('confirm') ?? '')) errors.confirm = 'The passwords don\'t match';
  else {
    const { error } = await session.supabase.auth.updateUser({ password });
    if (!error) {
      // Team members have no creator profile: send them to the CRM.
      if (!claim && (await isAdmin(session.supabase))) return Astro.redirect('/admin/creators/', 303);
      return Astro.redirect(claim ? '/creator/profile/?welcome=1' : '/creator/profile/?password=updated', 303);
    }
    message =
      error.code === 'same_password'
        ? 'Choose a password you haven\'t used here before.'
        : 'Your link may have expired. Ask for a new one and try again.';
  }
  Astro.response.status = 422;
}
---

<BaseLayout seo={{ title: 'Choose a password', noIndex: true }}>
  <PageHead size="compact"
    heading={claim ? 'Choose a password' : 'Choose a new password'}
    description={claim ? 'Then check your details are still right. Brands match against them.' : undefined}
  />
  <Section spacing="tight">
    <Container>
      <form method="post" novalidate class="flex max-w-[30rem] flex-col gap-6">
        {message && <p class="form-alert" role="alert">{message}</p>}
        <FormField name="password" label="New password" type="password" autocomplete="new-password" hint="At least 8 characters, with a letter and a number." error={errors.password} />
        <FormField name="confirm" label="Type it again" type="password" autocomplete="new-password" error={errors.confirm} />
        <div class="mt-2">
          <Button type="submit" size="large">Save password</Button>
        </div>
      </form>
    </Container>
  </Section>
</BaseLayout>
