---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Confirmation from '../../agency/components/sections/Confirmation.astro';

export const prerender = false;

// `claim`: the email belongs to a creator imported from the old site, so we
// sent a set-up link rather than creating a second profile.
const claim = Astro.url.searchParams.get('kind') === 'claim';
---

<BaseLayout seo={{ title: 'Check your inbox', noIndex: true }}>
  <Confirmation
    eyebrow={claim ? 'Welcome back' : 'Application received'}
    heading="Check your *inbox.*"
    body={claim
      ? "You're already in our creator network from our old website, so your details are safe with us. We've emailed you a link to set up your login: open it to choose a password and check your details are up to date."
      : "Thanks for applying. We've sent you a link to confirm your email address: open it to finish setting up your and your dog's profile."}
    note="Can't see it? Check your spam or promotions folder. The link works once."
    primary={{ label: 'Back to home', href: '/' }}
    secondary={{ label: 'Gifting guidelines', href: '/for-creators/gifting-guidelines/' }}
  />
</BaseLayout>
