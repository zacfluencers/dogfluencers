---
import BaseLayout from '../layouts/BaseLayout.astro';
import { clips } from '../agency/content/clips';
import PageHead from '../agency/components/sections/PageHead.astro';
import StatRow from '../agency/components/sections/StatRow.astro';
import Categories from '../agency/components/sections/Categories.astro';
import ListSplit from '../agency/components/sections/ListSplit.astro';
import WorkPosts from '../agency/components/sections/WorkPosts.astro';
import CtaBand from '../agency/components/sections/CtaBand.astro';
import { agency } from '../agency/config';
import { content } from '../content';
import { breadcrumbSchema } from '../system/lib/seo';


const [creatorCategories, statistics, work] = await Promise.all([
  content.creatorCategories(),
  content.statistics(),
  content.work(),
]);

// The last of the reel, so this masthead differs from For Creators, which
// opens on the first three.
const mastheadMedia = [clips.georgiaKneel, clips.spanielsLick, clips.colliePark];

const breadcrumbs = [{ label: 'Home', href: '/' }, { label: 'Creator network' }];

/**
 * Creator tiers describe the shape of the network. No individual creator is
 * named or pictured — personal information is not published here.
 */
const tiers = [
  {
    title: 'UGC creators',
    body: 'Make content for brand-owned channels. Audience size is not the point; consistency and craft are.',
  },
  {
    title: 'Micro creators',
    body: 'Smaller, highly engaged audiences. Strong for gifting at volume and for niche sub-categories.',
  },
  {
    title: 'Mid-tier creators',
    body: 'Established audiences with reach that can carry a launch message.',
  },
  {
    title: 'Larger creators',
    body: 'Used selectively, where a campaign needs a single moment of scale.',
  },
];
---

<BaseLayout
  seo={{
    title: 'Creator network',
    description:
      'The shape of our dog creator network: everyday dogs, breed specialists, puppies, rescues and dog models, from UGC makers to accounts with large followings.',
  }}
  schemas={[breadcrumbSchema(agency, breadcrumbs)]}
>
  <PageHead breadcrumbs={breadcrumbs} eyebrow="Creator network" heading="Who is in the *network.*" description={agency.creatorNetwork.description} primaryCta={agency.ctas.primary} media={mastheadMedia} card={{ title: 'Every breed', body: 'Every size, every age' }} />

  <StatRow eyebrow="The network" heading="In numbers" stats={statistics} />

  <Categories band="cream" eyebrow="Categories" heading="Every kind of dog" categories={creatorCategories} />

  <ListSplit eyebrow="Creator tiers" heading="From UGC makers to big accounts" description="Every campaign mixes tiers to fit the brief: volume, craft or a single moment of scale." items={tiers} />

  <WorkPosts eyebrow="The work" heading="Made by the *network.*" description={`Content dog owners in the network have made for ${agency.niche} brands.`} items={work.slice(0, 4)} />

  <CtaBand
    heading="Work with the *network.*"
    description="Brands: tell us what you are launching. Creators: join and start receiving briefs."
    primaryCta={agency.ctas.primary}
    secondaryCta={agency.ctas.secondary}
  />
</BaseLayout>
