---
/**
 * An insight as a card: rounded photo, category chip over its foot, the
 * title in the display face and the excerpt. The whole card is the link.
 */
import type { Article } from '../../../system/types/content';
import Photo from './Photo.astro';

interface Props { article: Article; size?: 'default' | 'lead' }
const { article, size = 'default' } = Astro.props;
const date = article.publishDate ? new Date(article.publishDate).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : undefined;
---

<a href={`/insights/${article.slug}/`} class:list={['dart lift', size === 'lead' && 'dart-lead']}>
  <div class="dart-media">
    <Photo src={article.featuredImage?.src} alt={article.featuredImage?.alt} ratio={size === 'lead' ? '16 / 10' : '4 / 3'} label="Article image" />
    {article.category && <span class="dart-cat d-ui">{article.category}</span>}
  </div>
  <div class="dart-copy">
    {date && <p class="d-small d-muted">{date}</p>}
    <h3 class:list={[size === 'lead' ? 'd-h2' : 'd-h3', 'mt-2']}>{article.title}</h3>
    <p class:list={[size === 'lead' ? 'd-lead' : 'd-body', 'd-muted mt-3']}>{article.excerpt}</p>
    <span class="dart-more d-ui">Read <span aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .dart { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .dart-media { position: relative; }
  .dart-cat { position: absolute; left: var(--overlay-inset); bottom: var(--overlay-inset); padding: 0.45rem 0.75rem; border-radius: 999px; background: rgb(255 250 243 / 0.92); backdrop-filter: blur(8px); font-size: 0.8125rem; color: var(--night); }
  .dart-copy { display: flex; flex-direction: column; flex: 1; padding-top: 1.25rem; }
  .dart-copy :global(h3), .dart-copy h3 { text-wrap: balance; }
  .dart-more { margin-top: auto; padding-top: 1.25rem; }
  .dart-more span { display: inline-block; transition: translate 200ms var(--bounce); }
  .dart:hover .dart-more { color: var(--orange-text); }
  .dart:hover .dart-more span { translate: 4px 0; }
  @media (min-width: 64rem) {
    .dart-lead { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); align-items: center; }
    .dart-lead .dart-copy { padding: 0 0 0 clamp(0rem, 3vw, 3rem); }
  }
</style>
