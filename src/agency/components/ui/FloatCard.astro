---
/**
 * The small white card that floats inside a masthead's main tile, with the
 * logo paw: the homepage hero's "Content delivered" card, reused so every
 * masthead carries one fact. It lifts in after the photos settle.
 */
import Paw from './Paw.astro';

interface Props { title: string; body: string }
const { title, body } = Astro.props;
---

<div class="dfloat" aria-hidden="true">
  <span class="dfloat-avatar"><Paw class="w-[55%]" /></span>
  <span>
    <span class="d-ui block">{title}</span>
    <span class="d-small d-muted">{body}</span>
  </span>
</div>

<style>
  .dfloat {
    position: absolute;
    left: var(--overlay-inset);
    bottom: var(--overlay-inset);
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.7rem 1.1rem 0.7rem 0.7rem;
    border-radius: var(--radius-md);
    background: #fff;
    color: var(--night);
    box-shadow: 0 1px 2px rgb(26 20 18 / 0.06), 0 12px 32px -12px rgb(26 20 18 / 0.28);
  }
  .dfloat-avatar { display: grid; place-items: center; flex: none; width: 2.5rem; height: 2.5rem; border-radius: 999px; background: var(--orange); color: #fff; }
  :global(html[data-motion]) .dfloat { animation: dfloat-in 700ms var(--ease-out) 900ms backwards; }
  :global(html[data-motion]) .dfloat-avatar { animation: dfloat-pop 500ms var(--bounce) 1200ms backwards; }
  @keyframes dfloat-in { from { opacity: 0; translate: 0 12px; } }
  @keyframes dfloat-pop { from { scale: 0.4; opacity: 0; } }
  @media (max-width: 30rem) {
    .dfloat { left: 0.6rem; right: 0.6rem; bottom: 0.6rem; gap: 0.55rem; padding: 0.5rem 0.75rem 0.5rem 0.5rem; }
    .dfloat-avatar { width: 2rem; height: 2rem; }
    .dfloat :global(.d-ui) { font-size: 0.8125rem; }
    .dfloat :global(.d-small) { font-size: 0.75rem; }
  }
</style>
