---
/**
 * A slim night strip fixed along the bottom of the screen, holding one action
 * that should always be in reach (booking a call) without competing with the
 * header. A cream line of lead text and a cream pill button with a calendar
 * icon, turning orange on hover, as buttons do on night bands. A cream hairline
 * on top keeps its edge where it passes over a night band. The page reserves
 * its height at the bottom, so the footer is never covered.
 */
import type { Link } from '../../system/types/content';

interface Props {
  /** Plain text before the button, e.g. "Prefer to talk?". Dropped on small phones. */
  lead?: string;
  link: Link;
}
const { lead, link } = Astro.props;
---

<div class="dcall" data-call-strip>
  <p class="wrap dcall-inner">
    {lead && <span class="dcall-lead">{lead}</span>}
    <a
      href={link.href}
      data-event={link.event}
      target={link.external ? '_blank' : undefined}
      rel={link.external ? 'noopener noreferrer' : undefined}
      class="dcall-btn"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3.5" y="5" width="17" height="15.5" rx="3" />
        <path d="M3.5 10h17M8.5 3v4M15.5 3v4" />
      </svg>
      {link.label}
      {link.external && <span class="sr-only">(opens in a new tab)</span>}
    </a>
  </p>
</div>

<style>
  .dcall {
    position: fixed;
    inset: auto 0 0;
    z-index: 40;
    background: var(--night);
    color: var(--cream);
    border-top: 1px solid rgb(249 234 208 / 0.16);
    padding-bottom: env(safe-area-inset-bottom);
    view-transition-name: call-strip;
  }
  .dcall-inner {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: var(--call-strip-h);
    margin-block: 0;
  }
  .dcall-lead {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--cream-muted);
  }
  .dcall-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.5rem;
    padding: 0 1.1rem 0 0.95rem;
    border-radius: 999px;
    background: var(--cream);
    color: var(--night);
    font-size: 0.875rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 200ms ease, transform 200ms var(--ease-out);
  }
  .dcall-btn svg { flex: none; width: 1rem; height: 1rem; }
  .dcall-btn:hover { background: var(--orange); }
  .dcall-btn:active { transform: scale(0.97); }
  .dcall-btn:focus-visible { outline: 2px solid var(--orange); outline-offset: 3px; }
  /* Phones: the lead line wrapped beside the pill and the pill sat tight to
     the strip's edges. Drop the lead and give the button the full width,
     taller and with room around it. */
  @media (max-width: 39.99rem) {
    .dcall-inner { padding-block: 0.75rem; }
    .dcall-lead { display: none; }
    .dcall-btn {
      flex: 1;
      justify-content: center;
      min-height: 3rem;
      font-size: 0.9375rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .dcall-btn { transition: none; }
  }
  :global(:root) { --call-strip-h: 3.75rem; }
  @media (max-width: 39.99rem) {
    :global(:root) { --call-strip-h: 4.5rem; }
  }
  :global(body:has([data-call-strip])) {
    padding-bottom: calc(var(--call-strip-h) + env(safe-area-inset-bottom));
  }
</style>
