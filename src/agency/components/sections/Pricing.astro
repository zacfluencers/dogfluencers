---
/**
 * Service packages as one pricing table, in the manner of Stripe and Linear:
 * a white panel split into columns by hairlines (a 1px grid gap over the
 * hairline colour, so the rules stay right at every column count).
 *
 * Each column: name and who it suits, a scale bar (its leading figure against
 * the biggest package's, so the step up reads at a glance, filling in as the
 * table arrives), the price, what's included with each leading figure in bold,
 * and its own button. A featured package, only for a fact the business stands
 * behind, gets an orange top rule and its badge; none is featured by default.
 */
import type { Link, ServicePackage } from '../../../system/types/content';
import SectionHead from './SectionHead.astro';
import Button from '../ui/Button.astro';

interface Props {
  heading: string;
  description?: string;
  packages: ServicePackage[];
  note?: string;
  cta: Link;
  band?: 'paper' | 'cream' | 'soft';
  /** The service these packages belong to: "Get started" opens the brief with it and the package chosen. */
  service?: string;
}
const { heading, description, packages, note, cta, band = 'paper', service } = Astro.props;
const startHref = (pkg: ServicePackage) =>
  service ? `${cta.href}?${new URLSearchParams({ service, package: pkg.name })}#enquiry` : cta.href;

/** "1,000 dogs gifted" → { figure: '1,000', rest: ' dogs gifted' }. */
const lead = (item: string) => {
  const m = item.match(/^([\d,.]+)(.*)$/);
  return m ? { figure: m[1], rest: m[2] } : { figure: '', rest: item };
};
const scaleOf = (pkg: ServicePackage) => Number(lead(pkg.inclusions[0] ?? '').figure.replace(/,/g, '')) || 0;
const biggest = Math.max(...packages.map(scaleOf));
---

<section class:list={['band', `band-${band}`]}>
  <div class="wrap">
    <SectionHead heading={heading} description={description} />
    <ul class:list={['dplan', `dplan-${Math.min(packages.length, 4)}`]} data-play>
      {packages.map((pkg, i) => {
        const scale = biggest ? Math.max(4, Math.round((scaleOf(pkg) / biggest) * 100)) : 0;
        return (
          <li class:list={['dplan-col', pkg.featured && 'is-featured']} style={`--i: ${i}`}>
            <div class="dplan-head">
              <div class="flex items-start justify-between gap-3">
                <h3 class="d-h3">{pkg.name}</h3>
                {pkg.badge && <span class="dplan-badge">{pkg.badge}</span>}
              </div>
              {pkg.summary && <p class="d-small d-muted mt-2">{pkg.summary}</p>}
            </div>
            {scale > 0 && (
              <div class="dplan-scale" aria-hidden="true"><span style={`--w: ${scale}%`}></span></div>
            )}
            <p class="dplan-price">
              <span class="dplan-amount">{pkg.price}</span>
              {pkg.priceNote && <span class="dplan-note">{pkg.priceNote}</span>}
            </p>
            <ul class="dplan-list">
              {pkg.inclusions.map((item) => {
                const { figure, rest } = lead(item);
                return (
                  <li>
                    <span class="dplan-tick" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M5 12.5l4.2 4.2L19 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                    <span>{figure && <strong>{figure}</strong>}{rest}</span>
                  </li>
                );
              })}
            </ul>
            <div class="dplan-foot">
              <Button href={startHref(pkg)} event={cta.event} variant={pkg.featured ? 'solid' : 'outline'} class="w-full" arrow>{cta.label}</Button>
            </div>
          </li>
        );
      })}
    </ul>
    {note && <p class="d-small d-muted dplan-footnote">{note}</p>}
  </div>
</section>

<style>
  .dplan {
    display: grid;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--hairline-strong);
    box-shadow: 0 0 0 1px var(--hairline-strong);
  }
  .dplan-col {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: var(--card-pad);
    background: #fff;
    transition: background-color 240ms ease;
  }
  .dplan-col:hover { background: var(--cream-soft); }
  .dplan-col.is-featured::before { content: ''; position: absolute; inset: 0 0 auto; height: 4px; background: var(--orange); }
  .dplan-head { min-height: 5.75rem; }
  @media (max-width: 39.99rem) { .dplan-head { min-height: 0; } }
  .dplan-badge { flex: none; padding: 0.3rem 0.65rem; border-radius: 999px; background: var(--orange); color: var(--night); font-size: 0.75rem; font-weight: 700; }

  /* The step up from package to package, as a bar. */
  .dplan-scale { height: 0.375rem; margin-top: 1.5rem; border-radius: 999px; background: rgb(26 20 18 / 0.08); overflow: hidden; }
  .dplan-scale span { display: block; height: 100%; width: var(--w); border-radius: inherit; background: var(--orange); }
  :global(html[data-motion]) .dplan-scale span { scale: 0 1; transform-origin: left; transition: scale 900ms var(--ease-out) calc(var(--i) * 120ms + 200ms); }
  :global(html[data-motion]) .dplan:global(.is-in) .dplan-scale span { scale: 1 1; }

  .dplan-price { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.4rem; margin: 1.25rem 0 0; }
  .dplan-amount { font-family: var(--font-display); font-stretch: 75%; font-weight: 800; font-size: clamp(2.75rem, 4vw, 3.5rem); line-height: 0.9; letter-spacing: -0.04em; }
  .dplan-note { font-size: 0.875rem; font-weight: 600; color: var(--night-muted); }

  .dplan-list { display: grid; gap: 0.7rem; margin: 1.75rem 0 0; padding: 1.5rem 0 0; list-style: none; border-top: 1px solid var(--hairline); font-size: 0.9375rem; }
  .dplan-list li { display: grid; grid-template-columns: 1.25rem 1fr; gap: 0.65rem; align-items: start; }
  .dplan-list strong { font-weight: 700; color: var(--night); }
  .dplan-tick { display: grid; place-items: center; width: 1.25rem; height: 1.25rem; margin-top: 0.05rem; border-radius: 999px; background: var(--orange); color: var(--night); }
  .dplan-tick svg { width: 0.7rem; height: 0.7rem; }

  .dplan-foot { margin-top: auto; padding-top: 2rem; }
  .dplan-foot :global(.dbtn) { width: 100%; }
  .dplan-footnote { max-width: 46rem; margin-top: 1.5rem; }

  @media (min-width: 40rem) { .dplan-2, .dplan-3, .dplan-4 { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .dplan-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 72rem) { .dplan-4 { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
</style>
