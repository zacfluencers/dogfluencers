---
/**
 * Service packages as rounded cards. The featured one is night, with its
 * badge as an orange chip; the rest are cream. Inclusions tick down a
 * hairline list, and every card ends on the same line (subgrid-free: the
 * cards are flex columns with the button pushed to the foot).
 */
import type { Link, ServicePackage } from '../../../system/types/content';
import SectionHead from './SectionHead.astro';
import Button from '../ui/Button.astro';

interface Props {
  heading: string;
  description?: string;
  packages: ServicePackage[];
  note?: string;
  cta: Link;
  band?: 'paper' | 'cream' | 'soft';
}
const { heading, description, packages, note, cta, band = 'paper' } = Astro.props;
---

<section class:list={['band', `band-${band}`]}>
  <div class="wrap">
    <SectionHead heading={heading} description={description} />
    <ul class:list={['dprice', packages.length >= 3 && 'dprice-3']} data-reveal-group>
      {packages.map((pkg) => (
        <li class:list={['dprice-card', pkg.featured ? 'band-night' : 'dprice-plain']}>
          <div class="flex items-start justify-between gap-4">
            <h3 class="d-h3">{pkg.name}</h3>
            {pkg.badge && <span class="dprice-badge">{pkg.badge}</span>}
          </div>
          <p class="dprice-price">{pkg.price}</p>
          {pkg.priceNote && <p class="d-small d-muted mt-1">{pkg.priceNote}</p>}
          {pkg.summary && <p class="d-body d-muted mt-4">{pkg.summary}</p>}
          <ul class="dprice-list">
            {pkg.inclusions.map((item) => <li>{item}</li>)}
          </ul>
          <div class="dprice-foot"><Button href={cta.href} event={cta.event} arrow>{cta.label}</Button></div>
        </li>
      ))}
    </ul>
    {note && <p class="d-small d-muted mt-8 max-w-[44rem]">{note}</p>}
  </div>
</section>

<style>
  .dprice { display: grid; gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .dprice-card { display: flex; flex-direction: column; padding: var(--card-pad); border-radius: var(--radius-lg); }
  .dprice-plain { background: var(--cream); }
  :global(.band-cream) .dprice-plain { background: var(--paper); }
  .dprice-badge { flex: none; padding: 0.35rem 0.7rem; border-radius: 999px; background: var(--orange); color: var(--night); font-size: 0.75rem; font-weight: 700; }
  .dprice-price { margin: 1.5rem 0 0; font-family: var(--font-display); font-stretch: 75%; font-weight: 800; font-size: clamp(2.25rem, 3.5vw, 3rem); line-height: 0.95; letter-spacing: -0.04em; text-transform: uppercase; }
  .dprice-list { margin: 1.5rem 0 0; padding: 0; list-style: none; border-top: 1px solid var(--hairline-strong); }
  .dprice-list li { position: relative; padding: 0.75rem 0 0.75rem 1.75rem; border-bottom: 1px solid var(--hairline); font-size: 0.9375rem; }
  .dprice-list li::before { content: ''; position: absolute; left: 0.15rem; top: 1.05rem; width: 0.8rem; height: 0.45rem; border-left: 2px solid var(--orange); border-bottom: 2px solid var(--orange); rotate: -45deg; }
  .dprice-foot { margin-top: auto; padding-top: 2rem; }
  @media (min-width: 48rem) { .dprice { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) { .dprice-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
</style>
