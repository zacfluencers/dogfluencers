---
/**
 * The perks as a bento grid. Each tile pairs one short claim with a small
 * piece of product-style UI that shows it: a day track, a field of dots, a
 * revision stack, a usage-rights card. Mostly cream; one orange and one
 * night tile for contrast.
 */
import SectionHead from './SectionHead.astro';
import Paw from '../ui/Paw.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  band?: 'paper' | 'soft';
}
const { eyebrow, heading, description, band = 'paper' } = Astro.props;
const days = Array.from({ length: 12 }, (_, i) => i + 1);
---

<section class:list={['band', `band-${band}`]}>
  <div class="wrap">
    <SectionHead eyebrow={eyebrow} heading={heading} description={description} />
    <ul class="dbento" data-reveal-group>
      <li class="dtile dtile-wide band-cream">
        <div class="dtrack" aria-hidden="true" data-play>
          <div class="dtrack-ends">
            <span><span class="d-small d-muted block">Day 1</span><span class="d-ui">Product arrives</span></span>
            <span class="text-right"><span class="d-small d-muted block">Day 12</span><span class="d-ui">Content delivered</span></span>
          </div>
          <ol class="dtrack-bar">
            {days.map((d) => (
              <li class:list={[d === 1 && 'is-start', d === days.length && 'is-end']} style={`--i: ${d - 1}`}><span class="d-small">{d}</span></li>
            ))}
          </ol>
          <p class="dtrack-mid d-small d-muted">Filming, editing and your review</p>
        </div>
        <div>
          <h3 class="d-h2">12 day delivery</h3>
          <p class="d-body d-muted mt-2">From product arriving to finished content in your inbox.</p>
        </div>
      </li>

      <li class="dtile band-orange">
        <div class="ddots" aria-hidden="true" data-play>
          {Array.from({ length: 100 }, (_, i) => <i class:list={[i % 9 === 4 && 'is-on']} style={`--i: ${i}`}></i>)}
        </div>
        <div>
          <h3 class="d-h2">1,000 dogs</h3>
          <p class="d-body mt-2">In a single gifting drop, each one matched to your product.</p>
        </div>
      </li>

      <li class="dtile band-night">
        <ol class="dedits" aria-hidden="true" data-play>
          <li style="--i: 0"><span>Draft 1</span><span class="d-muted">Changes requested</span></li>
          <li style="--i: 1"><span>Draft 2</span><span class="d-muted">Changes requested</span></li>
          <li class="is-done" style="--i: 2"><span>Draft 3</span><span>Approved</span></li>
        </ol>
        <div>
          <h3 class="d-h2">Unlimited edits</h3>
          <p class="d-body d-muted mt-2">Revisions until it matches the brief.</p>
        </div>
      </li>

      <li class="dtile band-cream">
        <dl class="drights" aria-hidden="true" data-play>
          <div><dt>Organic</dt><dd>Included</dd></div>
          <div><dt>Paid social</dt><dd>Included</dd></div>
          <div><dt>Duration</dt><dd>Lifetime</dd></div>
        </dl>
        <div>
          <h3 class="d-h2">Yours for life</h3>
          <p class="d-body d-muted mt-2">Lifetime ownership of your UGC, for organic and paid.</p>
        </div>
      </li>

      <li class="dtile band-cream">
        <ul class="dtasks" aria-hidden="true" data-play>
          {['Sourcing', 'Outreach', 'Dispatch', 'Briefing', 'Chasing', 'Reporting'].map((t, i) => (
            <li style={`--i: ${i}`}><Paw class="dtasks-paw" />{t}</li>
          ))}
        </ul>
        <div>
          <h3 class="d-h2">We do the work</h3>
          <p class="d-body d-muted mt-2">You approve the dogs and the content. We handle everything in between.</p>
        </div>
      </li>
    </ul>
  </div>
</section>

<style>
  .dbento { display: grid; gap: var(--grid-gap); margin: 0; padding: 0; list-style: none; }
  .dtile {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    min-height: 0;
    padding: var(--card-pad);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .dtile.band-cream { background: var(--cream); }
  .dtile :global(.d-h2) { font-size: clamp(2rem, 3vw, 2.75rem); }
  .dtile.band-night .d-muted { color: var(--cream-muted); }

  /* Day track: its own white panel, endpoints labelled above, seven
     day bars, the middle stretch named beneath. */
  .dtrack { display: grid; gap: 1.25rem; padding: clamp(1.25rem, 2.2vw, 1.75rem); border-radius: var(--radius-md); background: #fff; }
  .dtrack-ends { display: flex; justify-content: space-between; gap: 1rem; }
  .dtrack-bar { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 0.25rem; margin: 0; padding: 0; list-style: none; }
  .dtrack-bar li { display: grid; gap: 0.6rem; justify-items: center; color: var(--night-muted); }
  .dtrack-bar li::before { content: ''; width: 100%; height: 0.625rem; border-radius: 999px; background: rgb(26 20 18 / 0.1); }
  .dtrack-bar li.is-start::before { background: var(--night); }
  .dtrack-bar li.is-end::before { background: var(--orange); }
  .dtrack-bar li.is-end { color: var(--night); font-weight: 700; }
  .dtrack-mid { margin: 0; text-align: center; }

  /* A field of dots */
  .ddots { display: grid; grid-template-columns: repeat(20, 1fr); gap: 5px; max-width: 18rem; }
  .ddots i { aspect-ratio: 1; border-radius: 999px; background: rgb(249 234 208 / 0.4); }
  .ddots i.is-on { background: var(--cream); }

  /* Revision stack */
  .dedits { display: grid; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .dedits li { display: flex; justify-content: space-between; gap: 1rem; padding: 0.7rem 0.9rem; border-radius: var(--radius-sm); background: var(--night-soft); font-size: 0.875rem; font-weight: 600; }
  .dedits li.is-done { background: var(--orange); color: var(--night); }

  /* Usage rights */
  .drights { margin: 0; padding: 0.4rem 1rem; border-radius: var(--radius-md); background: #fff; }
  .drights div { display: flex; justify-content: space-between; padding-block: 0.6rem; font-size: 0.875rem; }
  .drights div + div { border-top: 1px solid var(--hairline); }
  .drights dt { color: var(--night-muted); }
  .drights dd { margin: 0; font-weight: 700; }

  /* Tasks */
  .dtasks { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .dtasks li { display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.4rem 0.75rem; border-radius: 999px; background: #fff; font-size: 0.875rem; font-weight: 600; }
  :global(.dtasks-paw) { width: 0.85rem; height: 0.85rem; color: var(--orange); }

  /* Storytelling, once each, when the tile scrolls in (DogMotion sets
     .is-in). The track fills day by day; the dots light up; the drafts
     stack until the third is approved; the rights tick in; the jobs land. */
  :global(html[data-motion]) .dtrack-bar li::before { transform-origin: left; scale: 0 1; transition: scale 420ms var(--ease-out) calc(var(--i) * 100ms + 150ms); }
  :global(html[data-motion]) .dtrack.is-in .dtrack-bar li::before { scale: 1 1; }
  :global(html[data-motion]) .dtrack-bar li.is-end span { transition: color 300ms ease 1400ms; color: var(--night-muted); }
  :global(html[data-motion]) .dtrack.is-in .dtrack-bar li.is-end span { color: var(--night); }
  :global(html[data-motion]) .dtrack-ends > span:last-child { opacity: 0; translate: 0 6px; transition: opacity 400ms ease 1350ms, translate 500ms var(--ease-out) 1350ms; }
  :global(html[data-motion]) .dtrack.is-in .dtrack-ends > span:last-child { opacity: 1; translate: 0 0; }

  :global(html[data-motion]) .ddots i { scale: 0.3; opacity: 0; transition: scale 360ms var(--bounce) calc(var(--i) * 9ms), opacity 200ms ease calc(var(--i) * 9ms); }
  :global(html[data-motion]) .ddots.is-in i { scale: 1; opacity: 1; }

  :global(html[data-motion]) .dedits li { opacity: 0; translate: 0 10px; transition: opacity 380ms ease calc(var(--i) * 260ms + 100ms), translate 480ms var(--ease-out) calc(var(--i) * 260ms + 100ms), background-color 400ms ease 900ms; }
  :global(html[data-motion]) .dedits li.is-done { background: var(--night-soft); color: var(--cream); }
  :global(html[data-motion]) .dedits.is-in li { opacity: 1; translate: 0 0; }
  :global(html[data-motion]) .dedits.is-in li.is-done { background: var(--orange); color: var(--night); }

  :global(html[data-motion]) .drights dd { opacity: 0; translate: 6px 0; transition: opacity 300ms ease, translate 400ms var(--ease-out); }
  :global(html[data-motion]) .drights.is-in div:nth-child(1) dd { transition-delay: 150ms; }
  :global(html[data-motion]) .drights.is-in div:nth-child(2) dd { transition-delay: 350ms; }
  :global(html[data-motion]) .drights.is-in div:nth-child(3) dd { transition-delay: 550ms; }
  :global(html[data-motion]) .drights.is-in dd { opacity: 1; translate: 0 0; }

  :global(html[data-motion]) .dtasks li { opacity: 0; scale: 0.85; transition: opacity 250ms ease calc(var(--i) * 110ms + 100ms), scale 420ms var(--bounce) calc(var(--i) * 110ms + 100ms); }
  :global(html[data-motion]) .dtasks.is-in li { opacity: 1; scale: 1; }

  @media (min-width: 48rem) { .dbento { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (min-width: 64rem) {
    .dbento { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .dtile-wide { grid-column: span 2; }
    .dtile { min-height: 20rem; }
  }
</style>
