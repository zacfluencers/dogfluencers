---
/**
 * Questions as quiet hairline rows that open in place. Heading and a
 * contact nudge on the left at desktop, the questions on the right.
 */
import type { Faq as FaqItem, Link } from '../../../system/types/content';
import Button from '../ui/Button.astro';

interface Props {
  eyebrow?: string;
  heading: string;
  description?: string;
  faqs: FaqItem[];
  link?: Link;
  band?: 'paper' | 'cream' | 'soft';
}
const { eyebrow, heading, description, faqs, link, band = 'paper' } = Astro.props;
---

{faqs.length > 0 && (
  <section class:list={['band', `band-${band}`]}>
    <div class="wrap dfaq">
      <div class="reveal-rise">
        {eyebrow && <p class="d-ui dfaq-eyebrow">{eyebrow}</p>}
        <h2 class="d-h2">{heading}</h2>
        {description && <p class="d-lead d-muted mt-5 max-w-[24rem]">{description}</p>}
        {link && <div class="mt-7"><Button href={link.href} variant="outline" arrow>{link.label}</Button></div>}
      </div>
      <div class="dfaq-list reveal-rise">
        {faqs.map((faq) => (
          <details>
            <summary>
              <span class="dfaq-q">{faq.question}</span>
              <span class="dfaq-icon" aria-hidden="true"></span>
            </summary>
            <p class="d-body d-muted">{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .dfaq { display: grid; gap: 3rem var(--grid-gap); }
  .dfaq-eyebrow { margin-bottom: 1rem; color: var(--accent); }
  .dfaq-list { border-top: 1px solid var(--hairline-strong); }
  details { border-bottom: 1px solid var(--hairline-strong); }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.5rem;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover .dfaq-q { color: var(--orange-text); }
  .dfaq-q { font-size: 1.125rem; font-weight: 600; line-height: 1.4; transition: color 160ms ease; }
  .dfaq-icon {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hairline-strong);
    border-radius: 999px;
    transition: background-color 160ms ease, border-color 160ms ease, rotate 240ms var(--ease-out);
  }
  .dfaq-icon::before,
  .dfaq-icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 0.75rem; height: 2px; margin: -1px 0 0 -0.375rem; border-radius: 2px; background: var(--night); }
  .dfaq-icon::after { rotate: 90deg; }
  details[open] .dfaq-icon { rotate: 45deg; background: var(--orange); border-color: var(--orange); }
  details p { max-width: 40rem; padding-bottom: 1.75rem; margin-top: -0.25rem; }
  @media (min-width: 64rem) { .dfaq { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); } }
</style>
