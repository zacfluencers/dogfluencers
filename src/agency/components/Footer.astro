---
/**
 * Dogfluencers footer: quiet and light. The wordmark and one line, link
 * columns, then the legal row, all on paper above a hairline.
 */
import { agency } from '../config';
import Paw from './ui/Paw.astro';

const year = new Date().getFullYear();
---

<footer class="band-paper dfoot">
  <div class="wrap">
    <div class="dfoot-top">
      <div class="dfoot-brand">
        <a href="/" aria-label={`${agency.name} home`}>
          <img src={agency.logo.src} alt={agency.logo.alt} width={agency.logo.width} height={agency.logo.height} loading="lazy" />
        </a>
        <p class="d-body d-muted mt-5 max-w-[28ch]">{agency.positioning.oneLine}</p>
        <a class="dfoot-mail d-ui mt-5" href={`mailto:${agency.contact.email}`}>{agency.contact.email}</a>
      </div>

      <div class="dfoot-cols">
        {agency.footerNavigation.map((group) => (
          <nav aria-label={group.heading}>
            <p class="d-ui dfoot-head">{group.heading}</p>
            <ul>{group.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}</ul>
          </nav>
        ))}
      </div>
    </div>

    <div class="dfoot-legal d-small">
      <p><Paw class="dfoot-paw" /> &copy; {year} {agency.name}. Part of Fluencers Group.</p>
      <ul>
        {agency.legalLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
        {agency.socialLinks.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
      </ul>
    </div>
  </div>
</footer>

<style>

  .dfoot { padding-block: clamp(3.5rem, 7vw, 5.5rem) 2rem; border-top: 1px solid var(--hairline); }
  .dfoot-top { display: grid; gap: 3rem; }
  .dfoot-brand img { display: block; width: 10rem; height: auto; }
  .dfoot-mail { display: inline-block; color: var(--night); text-decoration: none; border-bottom: 2px solid var(--orange); padding-bottom: 2px; }
  .dfoot-cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.5rem var(--grid-gap); }
  .dfoot-head { margin-bottom: 1rem; color: var(--night); }
  .dfoot ul { margin: 0; padding: 0; list-style: none; }
  .dfoot-cols li + li { margin-top: 0.6rem; }
  .dfoot-cols a,
  .dfoot-legal a { color: var(--night-muted); text-decoration: none; font-size: 0.9375rem; }
  .dfoot-cols a:hover,
  .dfoot-legal a:hover { color: var(--night); }
  .dfoot-legal { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem; margin-top: clamp(3rem, 6vw, 4.5rem); padding-top: 1.5rem; border-top: 1px solid var(--hairline); color: var(--night-muted); }
  .dfoot-legal p { display: flex; align-items: center; gap: 0.5rem; margin: 0; }
  :global(.dfoot-paw) { width: 1rem; height: 1rem; color: var(--orange); }
  .dfoot-legal ul { display: flex; flex-wrap: wrap; gap: 1.25rem; }
  @media (min-width: 64rem) {
    .dfoot-top { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--grid-gap); }
    .dfoot-cols { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
</style>
